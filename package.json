{
  "name": "elizaos-plugin-bluesky-search",
  "version": "0.2.1",
  "description": "Bluesky engagement discovery, post, like, reply, and follow/unfollow actions via AT Protocol XRPC API for ElizaOS agents",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "prepack": "npm run build",
    "prepare": "npm run build"
  },
  "keywords": [
    "elizaos",
    "eliza",
    "plugin",
    "bluesky",
    "atproto",
    "at-protocol",
    "social",
    "discovery",
    "engagement",
    "scout",
    "autonomous-agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xavier-arosemena/elizaos-plugin-bluesky-search.git"
  },
  "homepage": "https://github.com/xavier-arosemena/elizaos-plugin-bluesky-search#readme",
  "bugs": {
    "url": "https://github.com/xavier-arosemena/elizaos-plugin-bluesky-search/issues"
  },
  "author": "agents-ecosystem",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@elizaos/core": "0.1.9"
  },
  "devDependencies": {
    "typescript": "5.6.3",
    "@types/node": "^18.0.0"
  }
}
